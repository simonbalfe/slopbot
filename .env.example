# Host directory exposed read-only inside the VM at /host.
SLOPBOT_HOST_PATH=

# Overrides used by optional Docker/server development.
SLOPBOT_COMPUTER_URL=http://127.0.0.1:6080
SLOPBOT_COMPUTER_VIEW_URL=http://127.0.0.1:6080
SLOPBOT_COMPUTER_API_KEY=

# Server overrides; the managed VM supplies these itself.
PORT=4317
SLOPBOT_HOST=127.0.0.1
# SLOPBOT_WORKSPACE=/home/slopbot/workspace
# SLOPBOT_DATA_DIR=/data/runtime
