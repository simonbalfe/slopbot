# VM creation: omit or leave empty to mount ~/workspace.
SLOPBOT_WORKSPACE_PATH=

# Computer connection from native SlopBot. Optional Docker packaging uses
# http://host.docker.internal:6080. Remote computers use their reachable address.
SLOPBOT_COMPUTER_URL=http://127.0.0.1:6080
SLOPBOT_COMPUTER_VIEW_URL=http://127.0.0.1:6080
SLOPBOT_COMPUTER_API_KEY=

# Native server overrides; Compose supplies these itself.
# Nous-issued/approved OAuth client ID for SlopBot, not Hermes's client ID.
# Required for Nous subscription login; never put subscriber tokens here.
SLOPBOT_NOUS_CLIENT_ID=
PORT=4317
SLOPBOT_HOST=127.0.0.1
# Local host workspace; the macOS service defaults to ~/workspace.
# SLOPBOT_WORKSPACE=/absolute/path/to/workspace
# Native execution: set these to absolute local paths.
# SLOPBOT_DATA_DIR=/absolute/path/to/slopbot/data/runtime
