{
  "name": "openbot",
  "productName": "OpenBot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/electron-main.cjs",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run build:web && bun run build:electron && electron .",
    "start:server": "bun server.ts",
    "check": "tsc --noEmit",
    "build": "bun run build:web && bun build src/index.ts server.ts --target=bun --outdir=dist && bun run build:electron",
    "build:web": "vite build",
    "build:electron": "bun build desktop/main.ts --target=node --format=cjs --external=electron --outfile=dist/electron-main.cjs"
  },
  "dependencies": {
    "@openai/codex": "^0.153.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "bun-types": "1.3.5",
    "electron": "44.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.2.2"
  }
}
