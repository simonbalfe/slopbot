{
  "name": "slopbot-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "start": "bun run build:web && bun run build:electron && bun run --filter @slopbot/desktop start",
    "start:server": "bun run --filter @slopbot/server start",
    "check": "bun run --filter '*' check",
    "build": "bun run build:web && bun run build:server && bun run build:electron",
    "build:web": "bun run --filter @slopbot/web build",
    "build:server": "bun run --filter @slopbot/server build",
    "build:electron": "bun run --filter @slopbot/desktop build"
  },
  "devDependencies": {
    "bun-types": "1.3.5",
    "typescript": "5.9.3"
  }
}
