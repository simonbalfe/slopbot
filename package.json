{
  "name": "slopbot-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run up && bun run --filter @slopbot/web dev",
    "start": "bun run build:web && bun run start:server",
    "start:server": "bun run --filter @slopbot/server start",
    "check": "sh -n install.sh uninstall.sh && bun run --filter '*' check && tsc --noEmit -p vm",
    "build": "bun run build:web",
    "build:web": "bun run --filter @slopbot/web build",
    "chat": "bun apps/server/src/launch.ts",
    "up": "bun run vm:up",
    "runtime:up": "bun run vm:up",
    "runtime:stop": "bun run vm:stop",
    "runtime:restart": "bun vm/manage.ts restart",
    "docker:up": "docker compose up -d --build --remove-orphans --wait",
    "stop": "bun run vm:stop",
    "vm:up": "bun vm/manage.ts up",
    "vm:shell": "bun vm/manage.ts shell",
    "vm:stop": "bun vm/manage.ts stop",
    "chat:attach": "bun apps/server/src/chat.ts"
  },
  "devDependencies": {
    "bun-types": "1.3.5",
    "typescript": "5.9.3"
  }
}
